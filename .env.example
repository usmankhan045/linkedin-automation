# ============================================================
# LinkedIn Automation Engine — Environment Variables
# Copy this file to .env and fill in all values.
# .env is gitignored. NEVER commit real credentials.
# ============================================================


# ── AI / LLM ─────────────────────────────────────────────────────────────────

# Groq — post generation, comment classification, DM ghostwriting
# Get from: https://console.groq.com/keys
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=

# OpenAI — DALL-E 3 image generation
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.04/image (standard 1024x1024)
OPENAI_API_KEY=

# Anthropic — reserved for future Claude-specific steps (optional)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini — orchestrator decision engine (Gemini 2.0 Flash)
# Get from: https://aistudio.google.com/app/apikey
# Used by: orchestrator.py
GEMINI_API_KEY=


# ── LinkedIn API ──────────────────────────────────────────────────────────────

# OAuth app credentials
# Create app at: https://www.linkedin.com/developers/apps
# Required scopes: w_member_social, r_liteprofile, r_emailaddress
# Enable: "Share on LinkedIn", "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OAuth tokens (generated via Authorization Code flow)
# Access token expires: every 60 days
# Refresh token expires: every 12 months
# How to get: run `python tools/linkedin_auth.py` (generates tokens via browser OAuth)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# Your personal LinkedIn URN
# How to get: after OAuth, call GET https://api.linkedin.com/v2/me
# Returns: {"id": "XXXXXXXX", ...} → URN = "urn:li:person:XXXXXXXX"
LINKEDIN_PERSON_URN=


# ── Google Sheets ─────────────────────────────────────────────────────────────

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service account JSON — for GitHub Actions server-to-server auth
# How to get:
#   1. Google Cloud Console → IAM & Admin → Service Accounts → Create
#   2. Create JSON key → download file
#   3. Share your Google Sheet with the service account email (Editor access)
#   4. Paste the entire JSON content as a single line below (or base64-encode it)
# For local .env: path to the downloaded JSON file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials.json
# For GitHub Actions: paste the full JSON content as a secret named GOOGLE_SERVICE_ACCOUNT_JSON


# ── Supabase ──────────────────────────────────────────────────────────────────

# Get from: Supabase project → Settings → API
SUPABASE_URL=                 # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # Service role key — NOT the anon key (needs full table access)

# Storage bucket name (create manually in Supabase Storage)
# Set to Public read access so LinkedIn can download images via URL
SUPABASE_IMAGE_BUCKET=post-images


# ── Discord ───────────────────────────────────────────────────────────────────

# Bot token — used by the persistent dm_ghostwriter.py bot
# Create at: https://discord.com/developers/applications
# Bot settings: Enable "Message Content Intent" (required to read message text)
# Permissions needed: Read Messages, Send Messages, Read Message History
DISCORD_BOT_TOKEN=

# Channel IDs (right-click channel in Discord → Copy Channel ID)
# Requires Developer Mode: User Settings → Advanced → Developer Mode → ON
DISCORD_STORIES_CHANNEL_ID=         # #stories — where Muhammad submits personal stories
DISCORD_CONFIRMATIONS_CHANNEL_ID=   # #confirmations — publish confirmations + system alerts
DISCORD_LEADS_CHANNEL_ID=           # #leads — Category A comment alerts with drafted DM replies
DISCORD_DIGEST_CHANNEL_ID=          # #digest — Sunday weekly analytics summary
DISCORD_GHOSTWRITER_CHANNEL_ID=     # #ghostwriter — DM drafting via /biz /tech /follow /reply

# Webhook URLs — used by GitHub Actions scripts (one-way posting, no bot needed)
# Create at: Discord channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_CONFIRMATIONS=      # Used by: generate_posts.py, triage_comments.py
DISCORD_LEADS_WEBHOOK_URL=          # Used by: triage_comments.py (Category A lead alerts)
DISCORD_DIGEST_WEBHOOK_URL=         # Used by: weekly_digest.py
DISCORD_LEAD_HUNTER_WEBHOOK_URL=    # Used by: search_leads.py (outbound lead discovery alerts)

# Commands channel — discord_watcher.py bot listens here for !approve / !reject / etc.
DISCORD_COMMANDS_CHANNEL_ID=        # #commands — human control channel

# Semantic webhook URLs — used by notify() in discord_watcher.py
# Each maps to a dedicated Discord channel for that type of signal
DISCORD_WEBHOOK_NEEDS_ACTION=       # Items requiring human attention
DISCORD_WEBHOOK_APPROVAL=           # Approval request pings
DISCORD_WEBHOOK_LINKEDIN=           # LinkedIn publish confirmations
DISCORD_WEBHOOK_ERRORS=             # System errors and alerts (consider pinging yourself here)
DISCORD_WEBHOOK_BRIEFINGS=          # Daily/weekly summary digests
DISCORD_WEBHOOK_COMMANDS=           # Command echo / audit trail


# ── Lead Hunting ─────────────────────────────────────────────────────────────

# Apify — LinkedIn post scraper for lead hunting
# Required for: search_leads.py
# Get from: https://console.apify.com/account/integrations (API Tokens)
# Note: uses "LinkedIn Post Search Scraper" actor; free tier has limited runs
APIFY_API_TOKEN=


# ── App Config ────────────────────────────────────────────────────────────────

# Timezone for date calculations (publishing schedule, digest dates)
APP_TIMEZONE=Asia/Karachi

# Groq model to use for all text generation
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sheets tab names (change if you rename the tabs)
SHEETS_TOPIC_BANK_TAB=Topic Bank
SHEETS_CONTENT_BACKLOG_TAB=Content Backlog

# Obsidian Vault — vault_sync.py
# Absolute path to your Obsidian vault root
# Subdirs created automatically: Needs_Action, Plans, Pending_Approval, Approved, Done, Logs
VAULT_PATH=C:\Users\YourName\AI_Employee_Vault
